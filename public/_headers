# Headers de seguridad para los archivos ESTÁTICOS de public/.
# Las respuestas que genera el Worker (302, API, 404) los reciben desde
# src/lib/respuestas.js. Si cambiás algo acá, cambialo también allá:
# test/headers.test.js falla si no coinciden.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY

# El panel nunca se guarda en caché ni aparece en buscadores.
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Panel de clientes (/panel). Necesita que el navegador hable con Supabase,
# así que NO puede usar la CSP global (connect-src 'self'). La línea "!" la
# desacopla y la regla siguiente pone una propia: permite SOLO el host de
# nuestro proyecto de Supabase. El orden importa: esta regla va DESPUÉS de /*.
# Si cambia SUPABASE_URL, cambialo acá y en public/panel/config.js
# (test/panel.test.js verifica que los tres lugares coincidan).
/panel/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://safhlmjqpzwyyazjjzqb.supabase.co blob:; connect-src 'self' https://safhlmjqpzwyyazjjzqb.supabase.co; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
